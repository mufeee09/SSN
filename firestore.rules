rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FCM tokens: allow any client to create (save token); no read/update/delete from client
    match /fcmTokens/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    // Add your other collection rules below (e.g. hadiths, programs if they are read-only for clients)
    // match /hadiths/{id} { allow read: if true; allow write: if false; }
    // match /programs/{id} { allow read: if true; allow write: if false; }
  }
}
